# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google カレンダー同期（任意）
# GCP の OAuth 2.0 クライアント（ウェブアプリケーション）の資格情報。
# スコープは calendar.readonly に加えて `openid email` が必須
#   （userinfo の sub / email が取れねば接続を保存できない）。
# 承認済みリダイレクト URI に本番と http://localhost:3000/api/google/oauth/callback を登録すること。
# 値の末尾に改行を入れないこと（全 env 参照は ?.trim() で防御しているが、混入は避ける）。
# 未設定でもアプリは動作する（Google 連携が使えないだけ）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── cron（定時ジョブ）─────────────────────────────────────────
# Vercel Cron が自動送出する secret。`/api/cron/google-sync` が fail-closed で検証する
# （未設定なら 401 を返し、素通ししない）。
CRON_SECRET=

# Supabase pg_cron から `/api/cron/notify` を叩くための secret。
# ⚠️ **CRON_SECRET と必ず別値にすること。** pg_net は Authorization ヘッダを
#   `net.http_request_queue` に保存する（応答も `net._http_response` に残る）ため、
#   Dashboard の SQL Editor から読める場所に秘密が滞留する。使い回すと、その滞留
#   1 つで google-sync の cron も同時に開く。
# ⚠️ Vercel と **Supabase Vault の 2 箇所**へ同じ値を入れる。片方だけ変えると 5 分ごとに
#   401 を撃ち続けるが、`cron.job_run_details` は `succeeded` と言い張る（実際に起きた）。
# 手順: docs/runbooks/notify-cron.md
NOTIFY_CRON_SECRET=

# ── Web Push（通知）────────────────────────────────────────────
# `npx web-push generate-vapid-keys` で生成する。
# ⚠️ **一度だけ生成し、以後変えぬこと。** 変えると既存の購読が全て無効化され、
#   利用者全員が端末で登録し直すことになる。
# ⚠️ 公開鍵は **NEXT_PUBLIC_ の 1 変数に統一**する（サーバ用と分けて 2 本持つと、
#   食い違った時に無音で全配信が落ちる）。
# 未設定なら設定カードは購読ボタンを出さず「未設定」と表示する（画面が嘘をつかぬため）。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 送信元の連絡先。`mailto:` 形式（push サービスが障害時の連絡に使う）。
VAPID_SUBJECT=

# 地域ニュース（任意）
# 記事の閲覧・更新・通知に、追加の環境変数・AI API鍵は不要。利用者が /news で地域と通知ON/OFFを選ぶ。
# 取得・配信は既存の通知cronと上記VAPID設定を再利用する。
# 通知設定なし・地域未設定では地域ニュースのPushを送らない。
#
# ── 地域ニュースの AI 補助（アダプター実装済み／実接続は資格情報待ち・既定 OFF）──
# 未設定なら原文の見出しと出典をそのまま出す（AI 無しで全て動く）。有効にした時だけ、公開見出しから
# 固定語彙を抜き出す補助を Cloudflare Workers AI の無料枠で行う（有料 API への切替は無い）。
# Workers Free であることの確認は献立の AI 補助（下）と同じ。手順: docs/runbooks/regional-news.md
# `true` と完全一致のときだけ ON。
NEWS_AI_ENABLED=
# Cloudflare の Account ID（32 桁の hex）と API トークン。
NEWS_AI_ACCOUNT_ID=
NEWS_AI_API_TOKEN=
# 任意。1 日の呼出し回数の上限（1〜20）。**変数そのものを置かなければ 20。**
# ⚠️ 空文字（`NEWS_AI_DAILY_CALLS=`）を置くと 0 と読まれて範囲外になり、AI 補助が黙って止まる
#   （src/lib/news/ai.ts）。変える時だけ、下の行の # を外して数値を入れること。
# NEWS_AI_DAILY_CALLS=20

# ── 献立の AI 補助（アダプター実装済み／実接続は資格情報待ち・既定 OFF）──
# 未設定でも献立（自動献立・在庫提案・買い物）はすべて動く。AI は「希望文の構造化」と
# 「候補の並べ替え」を補助するだけで、無くても同じ画面が規則ベースの解釈で動く。
# ⚠️ **Cloudflare のアカウントが Workers Free であることをダッシュボードで確認してから有効化する。**
#   Free / Paid は API から判定できない。Workers Paid では 1 日 10,000 Neurons を超えた分が
#   課金されるため、**Paid のアカウントでは有効化しない**（Free なら超過分はエラーになるだけ）。
# ⚠️ 無料枠はアカウント全体で共有する。地域ニュースの AI（NEWS_AI_*）と同じ Account ID を
#   使うと、両方の利用が同じ 10,000 Neurons/日 から引かれる。
# ⚠️ ニュース用の NEWS_AI_* へはフォールバックしない。献立用は下の名前で別に設定する。
# 手順・上限時の挙動・送るデータ: docs/runbooks/meal-ai.md
# `true` と完全一致のときだけ ON。
MEAL_AI_ENABLED=
# Cloudflare の Account ID（32 桁の hex）。
MEAL_AI_ACCOUNT_ID=
# 権限は `Workers AI - Read` と `Workers AI - Edit` だけの API トークン。
MEAL_AI_API_TOKEN=
# 任意。空なら @cf/meta/llama-3.3-70b-instruct-fp8-fast。`@cf/<提供元>/<モデル>` の形だけ受け付ける。
# Workers Paid 必須のモデルは指定しない（指定しても呼び出さない）。
MEAL_AI_MODEL=
# 任意。空なら json_schema。モデルが response_format に対応しないときだけ json_object か off にする。
MEAL_AI_JSON_MODE=

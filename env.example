# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# レシート OCR（任意）
# 設定で「クラウド」方式を選ぶ場合のみ必要。Google Cloud Vision API のキー。
# 未設定でも「端末内(Tesseract.js)」「手入力」は動作する。
GOOGLE_VISION_API_KEY=

# Google カレンダー同期（任意）
# GCP の OAuth 2.0 クライアント（ウェブアプリケーション）の資格情報。
# スコープは calendar.readonly に加えて `openid email` が必須
#   （userinfo の sub / email が取れねば接続を保存できない）。
# 承認済みリダイレクト URI に本番と http://localhost:3000/api/google/oauth/callback を登録すること。
# 値の末尾に改行を入れないこと（全 env 参照は ?.trim() で防御しているが、混入は避ける）。
# 未設定でもアプリは動作する（Google 連携が使えないだけ）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── cron（定時ジョブ）─────────────────────────────────────────
# Vercel Cron が自動送出する secret。`/api/cron/google-sync` が fail-closed で検証する
# （未設定なら 401 を返し、素通ししない）。
CRON_SECRET=

# Supabase pg_cron から `/api/cron/notify` を叩くための secret。
# ⚠️ **CRON_SECRET と必ず別値にすること。** pg_net は Authorization ヘッダを
#   `net.http_request_queue` に保存する（応答も `net._http_response` に残る）ため、
#   Dashboard の SQL Editor から読める場所に秘密が滞留する。使い回すと、その滞留
#   1 つで google-sync の cron も同時に開く。
# ⚠️ Vercel と **Supabase Vault の 2 箇所**へ同じ値を入れる。片方だけ変えると 5 分ごとに
#   401 を撃ち続けるが、`cron.job_run_details` は `succeeded` と言い張る（実際に起きた）。
# 手順: docs/runbooks/notify-cron.md
NOTIFY_CRON_SECRET=

# ── Web Push（通知）────────────────────────────────────────────
# `npx web-push generate-vapid-keys` で生成する。
# ⚠️ **一度だけ生成し、以後変えぬこと。** 変えると既存の購読が全て無効化され、
#   利用者全員が端末で登録し直すことになる。
# ⚠️ 公開鍵は **NEXT_PUBLIC_ の 1 変数に統一**する（サーバ用と分けて 2 本持つと、
#   食い違った時に無音で全配信が落ちる）。
# 未設定なら設定カードは購読ボタンを出さず「未設定」と表示する（画面が嘘をつかぬため）。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 送信元の連絡先。`mailto:` 形式（push サービスが障害時の連絡に使う）。
VAPID_SUBJECT=
